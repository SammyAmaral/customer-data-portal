# =========================================================================
# Customer Data Portal — environment variables
#
# Server-side only (used by api/*.js — NEVER exposed to the browser):
# -------------------------------------------------------------------------
JIRA_BASE_URL=https://zyte.atlassian.net
JIRA_EMAIL=you@zyte.com
JIRA_API_TOKEN=your-atlassian-api-token         # id.atlassian.com/manage/api-tokens
JIRA_PROJECT=DOD

# Supabase — server side (token verification + allow-list read):
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key         # used to verify the caller's JWT
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # reads report_access, bypassing RLS

# Comma-separated internal email domains that get full access to every engagement.
INTERNAL_DOMAINS=zyte.com

# Anthropic API — used only to read per-feed prices out of the SOW PDF when a
# feed is missing its price in Jira. Optional: if unset, feeds without a Jira
# price simply show "—". ANTHROPIC_MODEL defaults to claude-opus-4-8.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Scrapy Cloud — live crawl telemetry per feed: item counts (records), recent
# volume, job state, close reason, errors. The Epic points at its production +
# development Scrapy Cloud projects; each feed's spider is looked up there via
# the jobs API (app.zyte.com/api/jobs/list.json), authed with this key.
# Optional: if unset, the report/tech view just omit the crawl columns.
# SCRAPYCLOUD_BASE defaults to https://app.zyte.com.
SCRAPYCLOUD_API_KEY=your-scrapy-cloud-api-key
SCRAPYCLOUD_BASE=https://app.zyte.com

# =========================================================================
# Client-side (bundled into the browser build — safe, anon key only):
# -------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
