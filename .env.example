# =========================================================================
# Customer Data Portal — environment variables
#
# Server-side only (used by api/*.js — NEVER exposed to the browser):
# -------------------------------------------------------------------------
JIRA_BASE_URL=https://zyte.atlassian.net
JIRA_EMAIL=you@zyte.com
JIRA_API_TOKEN=your-atlassian-api-token         # id.atlassian.com/manage/api-tokens
JIRA_PROJECT=DOD

# Supabase — server side (token verification + allow-list read):
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key         # used to verify the caller's JWT
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # reads report_access, bypassing RLS

# Comma-separated internal email domains that get full access to every engagement.
INTERNAL_DOMAINS=zyte.com

# INTERNAL_ONLY (default "true"): lock the portal to INTERNAL_DOMAINS users only —
# any other email is refused with a "restricted to Zyte staff" message and the
# per-customer allow-list is bypassed. Set to "false" to re-enable external
# customer access via the report_access table.
INTERNAL_ONLY=true

# Notifications (admin). NOTIFY_WEBHOOK_SECRET protects the Jira webhook
# receiver: a Jira admin creates a webhook to
#   https://<app>/api/jira-webhook?secret=<NOTIFY_WEBHOOK_SECRET>
# for the DOD project (events: issue updated + comment created). Email SENDING
# is stubbed for now (recorded in notify_log); add a provider key below later.
NOTIFY_WEBHOOK_SECRET=choose-a-long-random-string
# EMAIL_PROVIDER_KEY=            # e.g. Resend/SendGrid — wired when sending goes live
# EMAIL_FROM=data@zyte.com

# Anthropic API — used only to read per-feed prices out of the SOW PDF when a
# feed is missing its price in Jira. Optional: if unset, feeds without a Jira
# price simply show "—". ANTHROPIC_MODEL defaults to claude-opus-4-8.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Scrapy Cloud — live crawl telemetry per feed: item counts (records), recent
# volume, job state, close reason, errors. The Epic points at its production +
# development Scrapy Cloud projects; each feed's spider is looked up there via
# the HubStorage jobs API (storage.scrapinghub.com/jobq), authed with this key
# (a **Scrapy Cloud** API key, not a Zyte API/ZAPI key). Optional: if unset, the
# report/tech view just omit the crawl columns.
# SCRAPYCLOUD_BASE defaults to https://storage.scrapinghub.com (HubStorage host).
# SCRAPYCLOUD_APP_BASE (default https://app.zyte.com) is only used by the org
# fallback and isn't needed when the Epic sets its prod/dev project fields.
SCRAPYCLOUD_API_KEY=your-scrapy-cloud-api-key
SCRAPYCLOUD_BASE=https://storage.scrapinghub.com

# Bitbucket (OPTIONAL) — lets /api/schema-doc fetch a feed's real JSON-Schema
# from the private repo linked in its "Feed Schema" field (cf_13726) and render
# it as a customer-safe HTML page (fields · type · required · description), so
# customers never get redirected to Bitbucket. If UNSET, the schema page still
# works — it falls back to the latest sample crawl's field coverage. Use either
# a workspace/repo Access Token (Bearer) OR an account App Password:
#   • Access token:  set BITBUCKET_TOKEN only (leave BITBUCKET_USER blank)
#   • App password:  set BITBUCKET_USER (the account) + BITBUCKET_TOKEN (the pw)
# BITBUCKET_TOKEN=
# BITBUCKET_USER=

# =========================================================================
# Client-side (bundled into the browser build — safe, anon key only):
# -------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
